# Copy to .env for local runs. In Azure these become Container App secrets/env vars.

# The single login password (required).
ADMIN_PASSWORD=change-me-to-something-long

# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Azure Blob Storage. Leave both blank locally to use ./_local_files instead.
AZURE_STORAGE_CONNECTION_STRING=
# ...or, with managed identity, set just the account name:
AZURE_STORAGE_ACCOUNT=
BLOB_CONTAINER=uploads

MAX_UPLOAD_MB=512
ALLOWED_EXTENSIONS=zip,pptx,ppt,xlsx,xls,xlsm,csv
SESSION_HOURS=12

# Set to false only when testing over plain http on localhost.
COOKIE_SECURE=true
